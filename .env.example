# Lokálně: zkopíruj do .env.local (vercel dev). V produkci nastav ve Vercel > Settings > Environment Variables.
# POVINNÉ:
RESEND_API_KEY=re_xxxxxxxx
# VOLITELNÉ (výchozí hodnoty jsou v závorkách):
# MAIL_FROM="ALFA ESTATE <odhad@alfaestate.cz>"   # (odhad@<doména firemního e-mailu>) – doména musí být ověřená v Resendu
# AGENT_EMAIL=alfaestate@alfaestate.cz            # (firemní e-mail z site.config.json), více adres oddělit čárkou
# TURNSTILE_SECRET=
# LEAD_WEBHOOK_URL=https://hook.eu1.make.com/xxxx   # Make = hlavní cesta (Resend pak slouží jen jako záloha, RESEND_API_KEY není povinný)
